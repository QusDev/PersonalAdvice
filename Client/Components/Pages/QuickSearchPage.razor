@page "/quick-search"
@rendermode InteractiveServer

@using Client.Constant
@using Microsoft.Extensions.Options
@using Shared.DTOs.MediaContent
@using Shared.DTOs.Repositories
@using Shared.Enums

@inject HttpClient httpClient
@inject IOptions<ApiSettings> options

<style>
    .search-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        overflow: hidden;
    }

        .search-card:hover {
            transform: translateY(-3px);
            border-color: rgba(13, 110, 253, 0.5) !important;
            box-shadow: 0 10px 20px rgba(0,0,0,0.4) !important;
        }

    .object-fit-cover {
        object-fit: cover;
    }

    .form-control:focus {
        background-color: #1e1e1e !important;
        box-shadow: none;
        border-color: #0d6efd;
    }

    .badge {
        font-weight: 500;
        letter-spacing: 0.3px;
    }

    /* Стиль для плейсхолдера (робимо світлішим) */
    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.6) !important; /* Набагато світліший за стандартний */
        opacity: 1; /* Chrome потребує цього */
    }

    .btn-clear-search {
        color: rgba(255, 255, 255, 0.4) !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
        transition: all 0.2s ease-in-out;
        /* Анімація появи */
        animation: fadeInScale 0.25s ease-out forwards;
    }
        .btn-clear-search:hover {
            color: #dc3545 !important; /* Стає червоною при наведенні (стандарт danger) */
            background-color: rgba(220, 53, 69, 0.1) !important;
            border-color: #dc3545 !important;
        }

    @@keyframes fadeInScale {
        from {
            opacity: 0;
            transform: scale(0.8); /* Починаємо з трохи меншого розміру */
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* Стиль для плейсхолдера */
    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.6) !important;
    }
</style>

<div class="container-fluid p-4">
    <div class="d-flex align-items-center mb-4 gap-3">
        <div class="bg-primary rounded-3 p-2 shadow-sm">
            <i class="bi bi-lightning-charge-fill text-white fs-4"></i>
        </div>
        <h3 class="text-dark mb-0">Швидкий пошук</h3>
    </div>

    <div class="search-box mb-5">
        <div class="input-group input-group-lg shadow">
            <span class="input-group-text bg-dark border-secondary text-white">
                <i class="bi bi-search"></i>
            </span>
        
            <input type="text" class="form-control bg-dark text-white border-secondary"
                   placeholder="Назва фільму або треку..."
                   @bind="SearchQuery" @bind:event="oninput" @onkeyup="HandleKeyUp" />
        
            @if (!string.IsNullOrEmpty(SearchQuery))
            {
                @* Клас btn-clear-search запустить анімацію при появі *@
                <button class="btn btn-clear-search border-secondary bg-dark" @onclick="ClearSearch">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
        </div>
    </div>

    @if (_isSearching)
    {
        <div class="text-center py-5">
            <div class="spinner-grow text-primary" role="status"></div>
            <p class="text-muted mt-3 fw-light">Шукаємо у медіатеці...</p>
        </div>
    }
    else if (_searchResults.Any())
    {
        <div class="row g-3">
            @foreach (var item in _searchResults)
            {
                <div class="col-12 col-xl-6">
                    <div class="card bg-dark border-secondary h-100 search-card shadow-sm">
                        <div class="row g-0 h-100">
                            <!-- Фото/Обкладинка -->
                            <div class="col-4 col-sm-3 position-relative">
                                @if (!string.IsNullOrEmpty(item.PhotoUrl))
                                {
                                    <img src="@item.PhotoUrl" class="img-fluid rounded-start h-100 w-100 object-fit-cover" alt="@item.Title">
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 bg-secondary text-white-50 rounded-start">
                                        <i class="bi bi-image fs-1"></i>
                                    </div>
                                }
                                <!-- Тип медіа бейдж -->
                                <span class="position-absolute top-0 start-0 m-2 badge @(item.Type == MediaType.Movie ? "bg-primary" : "bg-success")">
                                    @(item.Type == MediaType.Movie ? "Фільм" : "Трек")
                                </span>
                            </div>

                            <!-- Інформація -->
                            <div class="col-8 col-sm-9">
                                <div class="card-body d-flex flex-column h-100 p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h5 class="card-title text-white mb-0 text-truncate">@item.Title</h5>
                                        <div class="d-flex align-items-center bg-black bg-opacity-25 px-2 py-1 rounded">
                                            <i class="bi bi-star-fill text-warning me-1 small"></i>
                                            <span class="text-white small fw-bold">@item.AverageRating.ToString("0.0")</span>
                                        </div>
                                    </div>

                                    <!-- Колаборатори (Director/Artist) -->
                                    @if (item.Author != null)
                                    {
                                        <p class="card-text text-info mb-2 small fw-medium">
                                            @item.Author.Person.FullName
                                        </p>
                                    }

                                    <!-- Жанри -->
                                    <div class="mb-3">
                                        @foreach (var genre in item.Genres.Take(3))
                                        {
                                            <span class="badge rounded-pill border border-secondary text-white-50 fw-light me-1" style="font-size: 0.7rem;">
                                                @genre.Name
                                            </span>
                                        }
                                    </div>

                                    <div class="mt-auto d-flex justify-content-end">
                                        <a href="@(item.Type == MediaType.Movie ? $"movies/{item.Id}" : $"tracks/{item.Id}")"
                                               class="btn btn-sm btn-outline-light px-3 rounded-pill border-secondary">
                                            Детальніше
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <Pagination CurrentPage="@_currentPage"
                    TotalPages="@_totalPages"
                    TotalCount="@_totalCount"
                    HasPrevious="@_hasPrevious"
                    HasNext="@_hasNext"
                    OnPageChanged="ChangePage" />
    }
</div>

@code {
    private string SearchQuery { get; set; } = "";
    private bool _isSearching;
    private List<MediaCardDto> _searchResults = new();

    private int _currentPage = 1;
    private int _totalPages = 1;
    private const int _pageSize = 6;
    private bool _hasPrevious;
    private bool _hasNext;
    private int _totalCount;

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await PerformSearch();
        }
    }

    private void ClearSearch()
    {
        SearchQuery = "";
        _searchResults.Clear();
        _currentPage = 1;
        _totalPages = 1;
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= _totalPages)
        {
            _currentPage = newPage;
            await PerformSearch();
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery)) return;

        _isSearching = true;
        try
        {
            var url = $"{options.Value.BackendApiBaseUrl}/media/search?title={SearchQuery}&page={_currentPage}&pageSize={_pageSize}";

            var response = await httpClient.GetFromJsonAsync<PagedResponse<MediaCardDto>>(url);
            _searchResults = response!.Items.ToList();
            _totalPages = response.TotalPages;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
        }
        finally
        {
            _isSearching = false;
        }
    }
}