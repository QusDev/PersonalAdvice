@inherits LayoutComponentBase

<div class="page d-flex">
    <aside style="width: 280px; position: fixed; left: 0; top: 0; bottom: 0;">
        <NavMenu />
    </aside>

    <main>
        <article class="flex-grow-1 p-4" style="margin-left: 280px; min-height: 100vh; background-color: #f8f9fa;">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
