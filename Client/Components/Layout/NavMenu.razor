@rendermode InteractiveServer

@using Client.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization

<style>
    .nav-link.active {
        font-weight: 600;
        background-color: rgba(13, 110, 253, 0.1);
    }

    .sidebar-container {
        background-color: #1a1d20 !important;
        z-index: 1000;
    }

    .nav-pills .nav-link {
        border-radius: 8px;
        transition: all 0.2s ease;
        margin-bottom: 4px;
    }

        .nav-pills .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

    .user-card {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        padding: 10px;
        transition: background 0.2s;
    }

        .user-card:hover {
            background: rgba(255, 255, 255, 0.1);
        }

    .user-info-link {
        text-decoration: none;
        color: white;
        flex-grow: 1;
        min-width: 0;
    }

    .logout-btn {
        background: none;
        border: none;
        color: #dc3545;
        padding: 5px;
        transition: color 0.2s;
    }

        .logout-btn:hover {
            color: #ff4d5a;
        }
</style>

<div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark vh-100 sidebar-container shadow">
    
    <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
        <span class="fs-4 fw-bold uppercase px-2">Personal<span class="text-primary">Advice</span></span>
    </a>
    <hr>

    <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item mb-1">
            <NavLink class="nav-link align-items-center text-white d-flex gap-2" href="recommendations">
                <i class="bi bi-stars d-flex me-0 fs-5"></i>
                <span>Рекомендації</span>
            </NavLink>
        </li>
        
        <li class="nav-item mb-1">
            <NavLink class="nav-link align-items-center text-white d-flex gap-2" href="catalog">
                <i class="bi bi-grid-3x3-gap fs-5 d-flex me-0 fs-5"></i>
                <span>Каталог</span>
            </NavLink>
        </li>

        <li class="nav-item mb-1">
            <NavLink class="nav-link align-items-center text-white d-flex gap-2" href="quick-search">
                <i class="bi bi-search-heart d-flex me-0 fs-5 text-info"></i>
                <span>Швидкий пошук</span>
            </NavLink>
        </li>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <li class="nav-item">
                    <NavLink class="nav-link text-warning d-flex align-items-center gap-2" href="admin">
                        <i class="bi bi-shield-lock d-flex me-0 fs-5"></i>
                        <span>Адмін панель</span>
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
    </ul>
    
    <hr>

    <div class="user-block">
        <AuthorizeView>
            <Authorized>
                <div class="user-card d-flex align-items-center gap-2">
                    
                    <a href="profile" class="user-info-link d-flex align-items-center gap-2 overflow-hidden">
                        <i class="bi bi-person-circle d-flex me-1 fs-4"></i>
                        <span class="text-truncate fw-semibold">@context.User.Identity?.Name</span>
                    </a>

                    <button class="logout-btn d-flex align-items-center" @onclick="HandleLogout" title="Вийти">
                        <i class="bi bi-box-arrow-right d-flex me-0 fs-4"></i>
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="d-grid gap-2">
                    <a href="login" class="btn btn-outline-primary btn-sm">Увійти</a>
                    <a href="register" class="btn btn-primary btn-sm">Реєстрація</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [Inject] private IAuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        NavManager.NavigateTo("/");
    }
}