@rendermode InteractiveServer

@using Client.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization

<style>
    .nav-link.active {
        color: var(--bs-primary-emphasis) !important;
        font-weight: 600;
    }

    .sidebar-container {
        background-color: #1a1d20 !important;
        z-index: 1000;
        display: flex;
        flex-direction: column;
    }

    .nav-pills .nav-link {
        border-radius: 8px;
        transition: all 0.2s ease;
        margin-bottom: 4px;
        cursor: pointer;
    }

        .nav-pills .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

    .dropdown-content {
        max-height: 0;
        overflow: hidden;
        list-style: none;
        padding-left: 1rem;
        margin: 0;
        transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), 
                    opacity 0.3s ease;
        opacity: 0;
        pointer-events: none;
    }

    .sidebar-dropdown:hover .dropdown-content,
    .sidebar-dropdown:focus-within .dropdown-content {
        max-height: 200px;
        opacity: 1;
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
        pointer-events: auto;
    }

    .arrow-icon {
        transition: transform 0.3s ease;
    }

    .sidebar-dropdown:hover .arrow-icon {
        transform: rotate(180deg);
    }

    .dropdown-content .nav-link {
        transform: translateX(-10px);
        transition: transform 0.3s ease;
    }

    .sidebar-dropdown:hover .dropdown-content .nav-link {
        transform: translateX(0);
    }

    .user-card {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        padding: 10px;
        transition: background 0.2s;
    }

        .user-card:hover {
            background: rgba(255, 255, 255, 0.1);
        }

    .user-info-link {
        text-decoration: none;
        color: white;
        flex-grow: 1;
        min-width: 0;
    }

    .logout-btn {
        background: none;
        border: none;
        color: #dc3545;
        padding: 5px;
        transition: color 0.2s;
    }

        .logout-btn:hover {
            color: #ff4d5a;
        }
</style>

<div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark vh-100 sidebar-container shadow">
    
    <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
        <span class="fs-4 fw-bold uppercase px-2">Personal<span class="text-primary">Advice</span></span>
    </a>
    <hr>

    <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item mb-1">
            <NavLink class="nav-link align-items-center text-white d-flex gap-2" href="recommendations">
                <i class="bi bi-stars d-flex me-0 fs-5"></i>
                <span>Рекомендації</span>
            </NavLink>
        </li>
        
        <li class="nav-item mb-1 sidebar-dropdown" tabindex="0">
            <div class="nav-link text-white d-flex align-items-center gap-2">
                <i class="bi bi-grid-3x3-gap d-flex me-0 fs-5"></i>
                <span>Каталог</span>
                <i class="bi-chevron-down ms-auto small arrow-icon d-flex me-0"></i>
            </div>
            <ul class="dropdown-content border-start border-secondary ms-3">
                <li><NavLink class="nav-link text-white-50 py-1" href="catalog/movies">Фільми</NavLink></li>
                <li><NavLink class="nav-link text-white-50 py-1" href="catalog/tracks">Треки</NavLink></li>
            </ul>
        </li>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <li class="nav-item">
                    <NavLink class="nav-link text-warning d-flex align-items-center gap-2" href="admin">
                        <i class="bi bi-shield-lock d-flex me-0 fs-5"></i>
                        <span>Адмін панель</span>
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
    </ul>
    
    <hr>

    <div class="user-block">
        <AuthorizeView>
            <Authorized>
                <div class="user-card d-flex align-items-center gap-2">
                    
                    <a href="profile" class="user-info-link d-flex align-items-center gap-2 overflow-hidden">
                        <i class="bi bi-person-circle d-flex me-1 fs-4"></i>
                        <span class="text-truncate fw-semibold">@context.User.Identity?.Name</span>
                    </a>

                    <button class="logout-btn d-flex align-items-center" @onclick="HandleLogout" title="Вийти">
                        <i class="bi bi-box-arrow-right d-flex me-0 fs-4"></i>
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="d-grid gap-2">
                    <a href="login" class="btn btn-outline-primary btn-sm">Увійти</a>
                    <a href="register" class="btn btn-primary btn-sm">Реєстрація</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [Inject] private IAuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        NavManager.NavigateTo("/");
    }
}